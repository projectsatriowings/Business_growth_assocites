generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BGA
  ACCOUNTS
  TECHNICAL
}

enum BgaStatus {
  DRAFT
  SUBMITTED
  VERIFICATION_PENDING
  UNDER_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  VERIFICATION_FAILED
  SUSPENDED
}

enum ServiceCategoryType {
  DIGITAL_MARKETING
  WEBSITE_DEVELOPMENT
  MOBILE_APPLICATION_DEVELOPMENT
  SOFTWARE_DEVELOPMENT
}

enum EnquiryStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum QuotationStatus {
  REQUESTED
  PREPARED
  PENDING_ADMIN_APPROVAL
  ADMIN_APPROVED
  SENT_TO_BGA
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum WorkOrderStatus {
  PENDING_ADVANCE
  ADVANCE_VERIFIED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum PaymentType {
  ADVANCE
  INTERIM
  FINAL
  MONTHLY_RECURRING
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  READY_TO_START
  IN_PROGRESS
  UNDER_REVIEW
  CORRECTION_REQUIRED
  COMPLETED
}

enum MilestoneStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum CommissionEligibility {
  PENDING_CRITERIA
  ELIGIBLE
  ON_HOLD
}

enum CommissionApproval {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum CommissionPayout {
  UNPAID
  PROCESSED
}

model User {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  emailVerified    Boolean      @default(false)
  emailVerifiedAt  DateTime?
  mobile           String       @unique
  mobileVerified   Boolean      @default(false)
  mobileVerifiedAt DateTime?
  passwordHash     String
  role             Role         @default(BGA)
  status           BgaStatus    @default(ACTIVE)
  profileImageUrl  String?
  dob              DateTime?
  address          String?
  city             String?
  district         String?
  state            String?
  pinCode          String?
  panNumber        String?
  panVerified      Boolean      @default(false)
  panVerifiedAt    DateTime?
  aadhaarNumber    String?
  aadhaarMasked    String?
  aadhaarVerified  Boolean      @default(false)
  aadhaarVerifiedAt DateTime?
  kycSubmittedAt   DateTime?
  bankName         String?
  bankAccountHolder String?
  bankAccountNumber String?
  bankIfsc         String?
  bankVerified     Boolean      @default(false)
  bankVerifiedAt   DateTime?
  panDocumentUrl   String?
  addressProofUrl  String?
  bankProofUrl     String?
  agreementAccepted Boolean     @default(false)
  agreementAcceptedAt DateTime?
  agreementDocumentUrl String?
  lastLoginAt      DateTime?
  rejectionReason  String?
  statusNotes      String?
  approvedAt       DateTime?
  approvedById     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  clients          Client[]     @relation("BgaClients")
  enquiries        Enquiry[]    @relation("BgaEnquiries")
  quotations       Quotation[]  @relation("BgaQuotations")
  workOrders       WorkOrder[]  @relation("BgaWorkOrders")
  commissions      Commission[] @relation("BgaCommissions")
  notifications    Notification[]
  auditLogs        AuditLog[]
  assignedProjects TechnicalProject[] @relation("LeadProjects")
  quotationReminders QuotationReminder[]
  passwordResetTokens PasswordResetToken[]
  commissionConfigs CommissionRateConfig[] @relation("BgaCommissionConfigs")
  finalPaymentFollowUps FinalPaymentFollowUp[] @relation("BgaFinalPaymentFollowUps")

  @@index([role, status])
  @@index([role, createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model ServiceItem {
  id             String              @id @default(cuid())
  category       ServiceCategoryType
  name           String
  code           String              @unique
  description    String
  basePrice      Float               @default(0)
  defaultCommissionRate Float        @default(10)
  isMonthly      Boolean             @default(false)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([category, isActive])
}

model CompanyResource {
  id              String              @id @default(cuid())
  title           String
  description     String?
  category        String              // PRESENTATION, PROFILE, PORTFOLIO, BROCHURE, CASE_STUDY, DEMO_VIDEO, PRICING
  serviceCategory ServiceCategoryType?
  fileUrl         String
  fileType        String              // PDF, PPT, MP4, IMAGE
  isPublished     Boolean             @default(true)
  isConfidential  Boolean             @default(false)
  uploadedById    String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([isPublished, isConfidential])
  @@index([category])
}

model Client {
  id               String       @id @default(cuid())
  clientName       String
  businessName     String
  mobile           String
  email            String
  location         String
  businessCategory String
  bgaId            String
  bga              User         @relation("BgaClients", fields: [bgaId], references: [id])
  status           String       @default("ACTIVE")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  enquiries        Enquiry[]
  quotations       Quotation[]
  workOrders       WorkOrder[]
  commissions      Commission[]
  technicalProjects TechnicalProject[]
  contactActivities ContactActivity[]
  commissionConfigs CommissionRateConfig[]
  commissionRateHistories CommissionRateHistory[]
  finalPaymentFollowUps FinalPaymentFollowUp[]

  @@unique([mobile])
  @@unique([email])
  @@index([mobile])
  @@index([email])
  @@index([bgaId])
  @@index([bgaId, status])
}

model Enquiry {
  id               String              @id
  clientId         String
  client           Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bgaId            String
  bga              User                @relation("BgaEnquiries", fields: [bgaId], references: [id])
  serviceCategory  ServiceCategoryType
  subCategory      String?
  expectedBudget   Float               @default(0)
  requirements     String
  discussionNotes  String?
  followUpDate     DateTime?
  attachmentUrl    String?
  status           EnquiryStatus       @default(SUBMITTED)
  adminNotes       String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  quotations       Quotation[]

  @@index([bgaId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model Quotation {
  id                     String          @id @default(cuid())
  quotationNumber        String          @unique
  version                Int             @default(1)
  enquiryId              String
  enquiry                Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  clientId               String
  client                 Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bgaId                  String
  bga                    User            @relation("BgaQuotations", fields: [bgaId], references: [id])
  preparedById           String?
  serviceCategory        ServiceCategoryType
  serviceScope           String
  serviceFee             Float
  adBudget               Float           @default(0)
  discount               Float           @default(0)
  taxRate                Float           @default(18)
  taxAmount              Float           @default(0)
  totalAmount            Float
  advanceRequiredPercent Float           @default(50)
  advanceRequiredAmount  Float
  paymentTerms           String
  validityDate           DateTime
  status                 QuotationStatus @default(REQUESTED)
  adminApprovalStatus    String?         @default("PENDING")
  adminNotes             String?
  adminReviewedAt        DateTime?
  adminReviewedById      String?
  lastReminderSentAt     DateTime?
  reminderCount          Int             @default(0)
  revisionNotes          String?
  previousVersionId      String?
  clientAcceptanceProof  String?
  clientAcceptanceNotes  String?
  acceptedAt             DateTime?
  acceptedByBgaId        String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Dual Approval & Commission Proposal Fields
  proposedCommissionRate     Float?
  commissionBillingType      String?         // PROJECT_BASED, MONTHLY_RECURRING
  commissionCalculationBasis String?         // NET_SERVICE_FEE, TOTAL_CONTRACT_VALUE
  commissionNotes            String?
  commissionRangeMin         Float?
  commissionRangeMax         Float?
  commissionExceptionReason  String?
  isCommissionException      Boolean         @default(false)
  commissionApprovalStatus   String?         @default("PENDING") // PENDING, APPROVED, REVISION_REQUESTED, REJECTED
  approvedCommissionRate     Float?
  commissionApprovedAt       DateTime?
  commissionApprovedById     String?

  workOrder              WorkOrder?
  reminders              QuotationReminder[]

  @@index([enquiryId])
  @@index([clientId])
  @@index([bgaId])
  @@index([status])
  @@index([createdAt])
}

model WorkOrder {
  id               String          @id @default(cuid())
  workOrderNumber  String          @unique
  quotationId      String          @unique
  quotation        Quotation       @relation(fields: [quotationId], references: [id])
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  bgaId            String
  bga              User            @relation("BgaWorkOrders", fields: [bgaId], references: [id])
  serviceCategory  ServiceCategoryType
  agreedScope      String
  totalValue       Float
  advanceRequired  Float
  advancePaid      Float           @default(0)
  advanceVerified  Boolean         @default(false)
  status           WorkOrderStatus @default(PENDING_ADVANCE)
  handoverApproved     Boolean     @default(false)
  handoverStatus       String?     @default("PENDING")
  handoverApprovedAt   DateTime?
  handoverApprovedById String?
  handoverNotes        String?
  approvedCommissionRate Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  payments         Payment[]
  project          TechnicalProject?
  commissions      Commission[]

  @@index([clientId])
  @@index([bgaId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                   String        @id @default(cuid())
  workOrderId          String
  workOrder            WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  paymentType          PaymentType
  amount               Float
  adBudgetAmount       Float         @default(0)
  netServiceFee        Float
  paymentMethod        String        // UPI, NEFT, RTGS, CHEQUE, ONLINE
  transactionReference String
  paymentDate          DateTime
  proofAttachmentUrl   String?
  status               PaymentStatus @default(PENDING_VERIFICATION)
  verifiedById         String?
  verifiedAt           DateTime?
  verificationNotes    String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  commissions          Commission[]

  @@index([workOrderId])
  @@index([status])
  @@index([paymentType])
  @@index([createdAt])
}

model TechnicalProject {
  id                   String             @id @default(cuid())
  projectNumber        String             @unique
  workOrderId          String             @unique
  workOrder            WorkOrder          @relation(fields: [workOrderId], references: [id])
  clientId             String
  client               Client             @relation(fields: [clientId], references: [id])
  serviceCategory      ServiceCategoryType
  approvedScope        String
  assignedLeadId       String?
  assignedLead         User?              @relation("LeadProjects", fields: [assignedLeadId], references: [id])
  status               ProjectStatus      @default(READY_TO_START)
  progressPercentage   Int                @default(0)
  startDate            DateTime?
  targetCompletionDate DateTime?
  completedAt          DateTime?
  clientAccessToken    String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  milestones           ProjectMilestone[]
  deliverables         ProjectDeliverable[]
  feedback             ProjectFeedback[]
  commissions          Commission[]
  closureStatus        String?            @default("OPEN") // OPEN, COMPLETED_AND_SETTLED, CLOSED
  closedAt             DateTime?
  closedById           String?
  commissionConfig     CommissionRateConfig?
  commissionRateHistories CommissionRateHistory[]
  finalPaymentFollowUps FinalPaymentFollowUp[]

  @@index([clientId])
  @@index([assignedLeadId])
  @@index([status])
  @@index([createdAt])
  @@index([clientAccessToken])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  project     TechnicalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  weight      Int             @default(1)
  targetDate  DateTime?
  status      MilestoneStatus @default(TODO)
  completedAt DateTime?
  completedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  deliverables ProjectDeliverable[]

  @@index([projectId])
  @@index([projectId, status])
}

model ProjectDeliverable {
  id                 String            @id @default(cuid())
  projectId          String
  project            TechnicalProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId        String?
  milestone          ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  fileUrl            String
  fileType           String?
  fileSize           Int?
  version            String            @default("1.0")
  uploadedById       String?
  status             String            @default("PENDING_BGA_REVIEW") // UPLOADED_INTERNAL, PENDING_BGA_REVIEW, APPROVED_FOR_CLIENT, SHARED_WITH_CLIENT, CLIENT_VIEWED, REVISION_REQUIRED, ACCEPTED_BY_CLIENT
  isClientVisible    Boolean           @default(false)
  clientViewedAt     DateTime?
  bgaReviewNotes     String?
  bgaApprovalStatus  String?           @default("PENDING") // PENDING, APPROVED, CHANGES_REQUESTED
  previousVersionId  String?
  createdAt          DateTime          @default(now())

  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
}

model ProjectFeedback {
  id                String           @id @default(cuid())
  projectId         String
  project           TechnicalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedbackType      String           // CLIENT_FEEDBACK, CORRECTION_REQUEST, INTERNAL_NOTE
  content           String
  status            String           @default("NEW") // NEW, ACKNOWLEDGED, UNDER_REVIEW, IN_PROGRESS, RESOLVED, CONFIRMED_BY_CLIENT, NEEDS_CLARIFICATION, REVISION_REQUIRED
  authorId          String?
  authorName        String?
  authorRole        String?          // CLIENT, BGA, TECHNICAL, ADMIN
  messageType       String?          // CLIENT_FEEDBACK, BGA_REPRESENTATIVE, TECHNICAL_REPLY, INTERNAL_NOTE
  milestoneId       String?
  deliverableId     String?
  visibility        String           @default("CLIENT_VISIBLE") // CLIENT_VISIBLE, INTERNAL
  parentFeedbackId  String?
  responseNotes     String?
  submittedById     String?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())

  @@index([projectId])
  @@index([projectId, status])
  @@index([visibility])
}

model Commission {
  id                  String                @id @default(cuid())
  bgaId               String
  bga                 User                  @relation("BgaCommissions", fields: [bgaId], references: [id])
  clientId            String
  client              Client                @relation(fields: [clientId], references: [id])
  workOrderId         String
  workOrder           WorkOrder             @relation(fields: [workOrderId], references: [id])
  paymentId           String?
  payment             Payment?              @relation(fields: [paymentId], references: [id])
  projectId           String?
  project             TechnicalProject?     @relation(fields: [projectId], references: [id])
  serviceCategory     ServiceCategoryType
  billingType         String                // MONTHLY_RECURRING, PROJECT_BASED
  grossAmount         Float
  excludedAdSpend     Float                 @default(0)
  commissionableAmount Float
  commissionRate      Float
  calculatedCommission Float
  eligibilityStatus   CommissionEligibility @default(PENDING_CRITERIA)
  approvalStatus      CommissionApproval    @default(PENDING_APPROVAL)
  approvedById        String?
  approvedAt          DateTime?
  payoutStatus        CommissionPayout      @default(UNPAID)
  payoutReference     String?
  payoutDate          DateTime?
  payoutMethod        String?               // NEFT, RTGS, IMPS, UPI
  payoutReceiptUrl    String?
  payoutProcessedById String?
  rateSource          String?               // PROJECT_OVERRIDE, CLIENT_DEFAULT, SYSTEM_DEFAULT
  rejectionReason     String?
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([bgaId])
  @@index([clientId])
  @@index([workOrderId])
  @@index([eligibilityStatus, payoutStatus])
  @@index([approvalStatus, payoutStatus])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ACTION_REQUIRED
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String?
  userRole   String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model QuotationReminder {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  bgaId       String
  bga         User      @relation(fields: [bgaId], references: [id])
  message     String?
  createdAt   DateTime  @default(now())

  @@index([quotationId])
  @@index([bgaId])
}

model ContactActivity {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bgaId             String
  contactMethod     String    // CALL, WHATSAPP, EMAIL, MEETING, OTHER
  discussionSummary String
  followUpNotes     String?
  nextFollowUpDate  DateTime?
  outcome           String?   // CONNECTED, BUSY, INTERESTED, FOLLOW_UP_SCHEDULED, NOT_INTERESTED, CONVERTED
  createdBy         String?
  createdAt         DateTime  @default(now())

  @@index([clientId])
  @@index([bgaId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model CommissionRateConfig {
  id                   String            @id @default(cuid())
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId            String?           @unique
  project              TechnicalProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bgaId                String?
  bga                  User?             @relation("BgaCommissionConfigs", fields: [bgaId], references: [id])
  commissionPercentage Float
  effectiveDate        DateTime          @default(now())
  expiryDate           DateTime?
  internalNotes        String?
  status               String            @default("ACTIVE") // ACTIVE, INACTIVE, EXPIRED
  createdById          String?
  updatedById          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  history              CommissionRateHistory[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model CommissionRateHistory {
  id              String                @id @default(cuid())
  configId        String?
  config          CommissionRateConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  clientId        String
  client          Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId       String?
  project         TechnicalProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  previousRate    Float?
  newRate         Float
  changedById     String?
  changedByName   String?
  reason          String
  createdAt       DateTime              @default(now())

  @@index([clientId])
  @@index([projectId])
  @@index([configId])
}

model FinalPaymentFollowUp {
  id                  String           @id @default(cuid())
  projectId           String
  project             TechnicalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bgaId               String
  bga                 User             @relation("BgaFinalPaymentFollowUps", fields: [bgaId], references: [id])
  followUpDate        DateTime         @default(now())
  contactMethod       String           // CALL, WHATSAPP, EMAIL, MEETING, OTHER
  clientResponse      String?
  notes               String
  expectedPaymentDate DateTime?
  expectedAmount      Float?
  status              String           @default("CLIENT_CONTACTED") // FOLLOW_UP_PENDING, CLIENT_CONTACTED, PAYMENT_PROMISED, PAYMENT_DELAYED, DISPUTED, FOLLOW_UP_REQUIRED
  createdAt           DateTime         @default(now())

  @@index([projectId])
  @@index([clientId])
  @@index([bgaId])
}

model CommissionRangeConfig {
  id              String              @id @default(cuid())
  serviceCategory ServiceCategoryType @unique
  minPercentage   Float
  maxPercentage   Float
  status          String              @default("ACTIVE") // ACTIVE, INACTIVE
  effectiveDate   DateTime            @default(now())
  updatedById     String?
  updatedByName   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([serviceCategory])
  @@index([status])
}

model EmailDeliveryLog {
  id             String   @id @default(cuid())
  eventType      String
  recipientId    String?
  recipientEmail String
  recipientRole  String?
  subject        String
  status         String   @default("PENDING") // PENDING, SENT, FAILED
  attempts       Int      @default(0)
  errorMessage   String?
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([recipientEmail])
  @@index([status])
  @@index([eventType])
  @@index([createdAt])
}

enum OtpType {
  EMAIL
  MOBILE
}

model RegistrationOtp {
  id          String    @id @default(cuid())
  sessionId   String
  identifier  String
  type        OtpType
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  resendAfter DateTime
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  consumed    Boolean   @default(false)
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sessionId, type])
  @@index([identifier, type])
  @@index([expiresAt])
}




