# =============================================================================
# BGA Management System - Production Environment Configuration Template
# Target Domain: https://bga.atriowings.in
# =============================================================================

# Server Port and Mode
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection URL (Replace with your actual database URL in your private .env)
DATABASE_URL="postgresql://username:password@ep-your-endpoint-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session & Authentication Tokens (Use a strong random string in your private .env)
JWT_SECRET="replace_with_strong_production_jwt_secret_key"

# Production Domain URLs (used for notification links and password reset links)
CLIENT_URL="https://bga.atriowings.in"
APP_URL="https://bga.atriowings.in"

# SMTP Gateway Configuration (Hostinger Business Email)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@atriowings.in
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Atriowings Technologies <info@atriowings.in>"
ADMIN_ALERT_EMAIL=admin.atriowings@gmail.com
